#!/usr/bin/env node

/**
 * MLSH - MarkLogic Shell
 * Entry point for global npm installation
 *
 * Node.js command entry point and interactive-shell launcher.
 */

import { spawn } from 'child_process';
import path from 'path';
import { fileURLToPath } from 'url';
import fs from 'fs';
import os from 'os';
import { runCli } from '../cli/main.js';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

// Get the mlsh installation directory
// When installed globally, this will be in node_modules/mlsh
const MLSH_TOP_DIR = path.resolve(__dirname, '..');

// Verify key files exist
const requiredFiles = [
  'cli/main.js',
  'shell/bashrc'
];

const missingFiles = requiredFiles.filter(file => {
  return !fs.existsSync(path.join(MLSH_TOP_DIR, file));
});

if (missingFiles.length > 0) {
  console.error('Error: MLSH installation appears to be incomplete.');
  console.error('Missing files:');
  missingFiles.forEach(f => console.error(`  - ${f}`));
  console.error(`Installation directory: ${MLSH_TOP_DIR}`);
  process.exit(1);
}

// Set up environment
process.env.MLSH_TOP_DIR = MLSH_TOP_DIR;

async function main() {
  const [, , ...args] = process.argv;
  if (args[0] === 'session-log') showLog(args.slice(1));
  else if (args.length === 0) runInteractiveShell();
  else process.exitCode = await runCli(args, { topDir: MLSH_TOP_DIR });
}

main().catch(error => {
  console.error(`mlsh: ${error.message}`);
  process.exitCode = 1;
});

function logFilePath() {
  return path.join(process.env.HOME || os.homedir(), '.mlsh', 'mlsh.log');
}

function sessionLogFilePath() {
  return path.join(process.env.HOME || os.homedir(), '.mlsh', 'mlsh-session.log');
}

function showLog(args) {
  const logFile = args[0] === 'transcript' ? sessionLogFilePath() : logFilePath();
  const action = args[0] === 'transcript' ? args[1] : args[0];
  if (action === 'show') {
    const pager = process.env.PAGER || 'less';
    const viewer = spawn(pager, ['-R', logFile], { stdio: 'inherit' });
    viewer.on('error', () => {
      const fallback = spawn('cat', [logFile], { stdio: 'inherit' });
      fallback.on('exit', code => process.exit(code || 0));
    });
    viewer.on('exit', code => process.exit(code || 0));
  } else if (action === 'tail') {
    const tail = spawn('tail', ['-f', logFile], { stdio: 'inherit' });
    tail.on('exit', code => process.exit(code || 0));
  } else {
    console.log(logFile);
  }
}

function runInteractiveShell() {
  const bash = spawn('bash', ['--noprofile', '--rcfile', path.join(MLSH_TOP_DIR, 'shell/bashrc'), '-i'], {
    stdio: 'inherit',
    env: shellEnvironment()
  });

  bash.on('error', (err) => {
    console.error('Error starting mlsh shell:', err.message);
    process.exit(1);
  });

  bash.on('exit', (code) => {
    process.exit(code || 0);
  });
}

function shellEnvironment() {
  const logDirectory = path.join(process.env.HOME || os.homedir(), '.mlsh');
  const logFile = logFilePath();
  const sessionLogFile = sessionLogFilePath();
  fs.mkdirSync(logDirectory, { recursive: true, mode: 0o700 });

  // Rotate rather than truncate, so the run that just failed is still readable.
  for (const file of [logFile, sessionLogFile]) {
    if (fs.existsSync(file) && fs.statSync(file).size > 10 * 1024 * 1024) {
      fs.renameSync(file, `${file}.1`);
    }
    if (!fs.existsSync(file)) fs.closeSync(fs.openSync(file, 'a', 0o600));
  }

  const env = {
    ...process.env,
    HOME: process.env.HOME || os.homedir(),
    MLSH_LOG_FILE: logFile,
    MLSH_SESSION_LOG_FILE: sessionLogFile,
    MLSH_TOP_DIR // This is the key - explicitly set to repo location
  };

  return env;
}
