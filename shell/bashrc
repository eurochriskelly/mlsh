#!/bin/bash

test -f "$HOME/.mlshrc-gen" && source "$HOME/.mlshrc-gen"
source "$MLSH_TOP_DIR/scripts/mlsh.sh"

mlsh() {
  if [ "$#" -eq 0 ]; then
    echo "Already inside the MLSH shell. Type 'help' for commands or 'exit' to leave."
    return
  fi
  mlsh_command "$@"
}

mlsh_help() {
  printf '%s\n' \
    'MLSH commands:' \
    '  env                 Create, select, or edit an environment' \
    '  eval <script> ...   Evaluate XQuery or JavaScript' \
    '  logs <options>      Query MarkLogic logs' \
    '  qc <command>        Manage Query Console workspaces' \
    '  mlcp <args>         Run MLCP' \
    '  corb <args>         Run CoRB' \
    '  modules <command>   Manage modules' \
    '  backup <command>    Manage backups' \
    '  help <command>      Show detailed command help' \
    '  exit                Leave MLSH' \
    '' \
    'Normal shell commands such as cd, ls, git, pipes, and redirection also work.'
}

env() {
  mlsh_command env "$@"
  test -f "$HOME/.mlshrc-gen" && source "$HOME/.mlshrc-gen"
}

help() {
  if [ "$#" -eq 0 ]; then
    mlsh_help
  else
    mlsh_command help "$@"
  fi
}
eval() { mlsh_command eval "$@"; }
logs() { mlsh_command logs "$@"; }
log() { mlsh_command log "$@"; }
qc() { mlsh_command qc "$@"; }
qconsole() { mlsh_command qconsole "$@"; }
mlcp() { mlsh_command mlcp "$@"; }
corb() { mlsh_command corb "$@"; }
modules() { mlsh_command modules "$@"; }
module() { mlsh_command module "$@"; }
backup() { mlsh_command backup "$@"; }
update() { mlsh_command update "$@"; }

alias h=help
alias q=qc
alias e=eval
alias l=logs
alias mod=modules

PS1='mlsh [${ML_ENV:-none}]> '
clear
printf 'Welcome to MLSH'
if [ -n "$ML_ENV" ]; then
  printf ' (%s)' "$ML_ENV"
fi
printf '. Type help for commands.\n\n'
mlsh_help
