#!/bin/bash

export MLSH_INTERACTIVE=1
mlsh_install_dir="$MLSH_TOP_DIR"
test -f "$HOME/.mlshrc-gen" && source "$HOME/.mlshrc-gen"
export MLSH_TOP_DIR="$mlsh_install_dir"
unset mlsh_install_dir
if [ -z "$MLSH_LOG_FILE" ]; then
  export MLSH_LOG_FILE="$HOME/.mlsh/mlsh.log"
fi
if [ -z "$MLSH_SESSION_LOG_FILE" ]; then
  export MLSH_SESSION_LOG_FILE="$HOME/.mlsh/mlsh-session.log"
fi
mkdir -p "$(dirname "$MLSH_LOG_FILE")"
for mlsh_f in "$MLSH_LOG_FILE" "$MLSH_SESSION_LOG_FILE"; do
  if [ -f "$mlsh_f" ] && [ "$(wc -c <"$mlsh_f")" -gt 10485760 ]; then
    mv -f "$mlsh_f" "${mlsh_f}.1"
  fi
  touch "$mlsh_f"
done
unset mlsh_f
export MLSH_LOG_LEVEL="${MLSH_LOG_LEVEL:-info}"
printf '%s INFO  [shell] session started env=%s host=%s:%s pid=%s\n' \
  "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "${ML_ENV:-none}" "${ML_HOST:-unset}" "${ML_PORT:-unset}" "$$" >>"$MLSH_LOG_FILE"

mlsh_reset=$'\033[0m'
mlsh_muted=$'\033[38;5;245m'
mlsh_purple=$'\033[38;5;141m'
mlsh_cyan=$'\033[38;5;81m'
mlsh_green=$'\033[38;5;114m'
mlsh_bold=$'\033[1m'

mlsh() {
  if [ "$#" -eq 0 ]; then
    echo "Already inside the MLSH shell. Type 'help' for commands or 'exit' to leave."
    return
  fi
  if [ "$1" = "session-log" ]; then
    shift
    session-log "$@"
    return
  fi
  mlsh_run "$@"
}

# mlsh_run - Run a command, logging the invocation and its exit status to the
# diagnostic log, and the (ANSI-stripped) terminal output to the session log.
mlsh_run() {
  node "$MLSH_TOP_DIR/bin/mlsh" "$@" 2>&1 | tee >(sed $'s/\033\\[[0-9;]*[a-zA-Z]//g' >>"$MLSH_SESSION_LOG_FILE")
  local status="${PIPESTATUS[0]}"
  return "$status"
}

mlsh_help() {
  printf '\n%s%sCOMMANDS%s\n' "$mlsh_bold" "$mlsh_purple" "$mlsh_reset"
  mlsh_command_line 'env' 'Create, select, or edit an environment'
  mlsh_command_line 'eval <script> ...' 'Evaluate XQuery or JavaScript'
  mlsh_command_line 'logs <options>' 'Query MarkLogic logs'
  mlsh_command_line 'qc <command>' 'Manage Query Console workspaces'
  mlsh_command_line 'mlcp <import|export|copy> [job]' 'Run MLCP jobs via ml-gradle'
  mlsh_command_line 'corb <args>' 'Run CoRB'
  mlsh_command_line 'modules <command>' 'Manage modules'
  mlsh_command_line 'backup <command>' 'Manage backups'
  mlsh_command_line 'session-log [show]' 'Locate or view the diagnostic log'
  mlsh_command_line 'debug [on|off]' 'Set diagnostic log verbosity'
  mlsh_command_line 'help <command>' 'Show detailed command help'
  mlsh_command_line 'exit' 'Leave MLSH'
  printf '\n%sTip:%s ordinary shell commands such as %scd%s, %sgit%s, pipes, and redirection work too.\n' \
    "$mlsh_green" "$mlsh_reset" "$mlsh_cyan" "$mlsh_reset" "$mlsh_cyan" "$mlsh_reset"
}

mlsh_command_line() {
  printf '  %s%-22s%s %s%s%s\n' "$mlsh_cyan" "$1" "$mlsh_reset" "$mlsh_muted" "$2" "$mlsh_reset"
}

env() {
  mlsh_run env "$@" || return
  test -f "$HOME/.mlshrc-gen" && source "$HOME/.mlshrc-gen"
}

help() {
  if [ "$#" -eq 0 ]; then
    mlsh_help
  else
    mlsh_run help "$@"
  fi
}
eval() { mlsh_run eval "$@"; }
logs() { mlsh_run logs "$@"; }
log() { mlsh_run log "$@"; }
qc() { mlsh_run qc "$@"; }
qconsole() { mlsh_run qconsole "$@"; }
mlcp() { mlsh_run mlcp "$@"; }
corb() { mlsh_run corb "$@"; }
modules() { mlsh_run modules "$@"; }
module() { mlsh_run module "$@"; }
backup() { mlsh_run backup "$@"; }
update() { mlsh_run update "$@"; }
session-log() {
  local target="$MLSH_LOG_FILE"
  local action="$1"
  if [ "$1" = "transcript" ]; then
    target="$MLSH_SESSION_LOG_FILE"
    shift
    action="$1"
  fi
  case "$action" in
  show)
    if command -v less >/dev/null 2>&1; then
      less -R "$target"
    else
      cat "$target"
    fi
    ;;
  tail)
    tail -f "$target"
    ;;
  clear)
    : >"$target"
    echo "Cleared $target"
    ;;
  *)
    echo "$target"
    ;;
  esac
}

# debug - Show or set the diagnostic log verbosity.
debug() {
  case "$1" in
  "")
    echo "Log level: $MLSH_LOG_LEVEL  (log: $MLSH_LOG_FILE)"
    ;;
  on)
    export MLSH_LOG_LEVEL=debug
    echo "Log level: debug"
    ;;
  off)
    export MLSH_LOG_LEVEL=info
    echo "Log level: info"
    ;;
  trace | debug | info | warn | error | off)
    export MLSH_LOG_LEVEL="$1"
    echo "Log level: $1"
    ;;
  *)
    echo "Usage: debug [on|off|trace|debug|info|warn|error]"
    return 1
    ;;
  esac
}

alias h=help
alias q=qc
alias e=eval
alias l=logs
alias mod=modules

PS1='\[\033[38;5;141m\]mlsh \[\033[38;5;81m\][${ML_ENV:-none}]\[\033[38;5;141m\]> \[\033[0m\]'
clear
printf '%s%s ███╗   ███╗██╗     ███████╗██╗  ██╗%s\n' "$mlsh_bold" "$mlsh_purple" "$mlsh_reset"
printf '%s%s ████╗ ████║██║     ██╔════╝██║  ██║%s\n' "$mlsh_bold" "$mlsh_purple" "$mlsh_reset"
printf '%s%s ██╔████╔██║██║     ███████╗███████║%s\n' "$mlsh_bold" "$mlsh_purple" "$mlsh_reset"
printf '%s%s ██║╚██╔╝██║██║     ╚════██║██╔══██║%s\n' "$mlsh_bold" "$mlsh_purple" "$mlsh_reset"
printf '%s%s ██║ ╚═╝ ██║███████╗███████║██║  ██║%s\n' "$mlsh_bold" "$mlsh_purple" "$mlsh_reset"
printf '%s%s ╚═╝     ╚═╝╚══════╝╚══════╝╚═╝  ╚═╝%s\n' "$mlsh_bold" "$mlsh_purple" "$mlsh_reset"
printf '%sMarkLogic shell%s  %sEnvironment: %s%s%s\n' \
  "$mlsh_muted" "$mlsh_reset" "$mlsh_muted" "$mlsh_cyan" "${ML_ENV:-none}" "$mlsh_reset"
printf '%sDiagnostic log:%s %s  %s(session-log show | session-log tail | debug on)%s\n' \
  "$mlsh_muted" "$mlsh_reset" "$MLSH_LOG_FILE" "$mlsh_muted" "$mlsh_reset"
mlsh_help
